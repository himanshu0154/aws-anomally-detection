import inspect

print(inspect.getsource(detect_status))


def detect_status(
    row,
    recent_temps,
    model,
    features,
    expected_model=None
):
    # 1. Communication error
    if row[['T2M', 'RH2M', 'PS']].isna().any():
        return {
            'status': 'anomaly',
            'type': 'communication_error',
            'severity': 'high',
            'reason': 'Missing sensor reading'
        }

    # 2. Temperature spike
    if (
        abs(row['T2M_diff']) > 8
        and row['temp_deviation'] > 5
    ):
        return {
            'status': 'anomaly',
            'type': 'temperature_spike',
            'severity': 'high',
            'reason': 'Temperature changed suddenly and differs significantly from expected conditions'
        }

    # 3. Frozen sensor
    if len(recent_temps) >= 6:
        if recent_temps[-6:].std() < 0.05:
            return {
                'status': 'anomaly',
                'type': 'temperature_frozen',
                'severity': 'medium',
                'reason': 'Temperature barely changed for 6 readings'
            }

    # 4. Expected temperature / drift
    if expected_model is not None:
        expected_temp = expected_model.predict(
            row[expected_features].values.reshape(1, -1)
        )[0]

        deviation = abs(row['T2M'] - expected_temp)

        if deviation > 5:
            return {
                'status': 'anomaly',
                'type': 'possible_drift',
                'severity': 'medium',
                'reason': 'Temperature significantly differs from expected conditions'
            }

    # 5. Isolation Forest — supporting evidence only
    x = row[features].values.reshape(1, -1)
    pred = model.predict(x)[0]
    
    if pred == -1 and row['temp_deviation'] > 5:
        return {
            'status': 'anomaly',
            'type': 'ml_anomaly',
            'severity': 'medium',
            'reason': 'Unusual sensor pattern with significant temperature deviation'
        }

    # 6. Normal
    return {
        'status': 'normal',
        'type': 'normal',
        'severity': 'none',
        'reason': 'No abnormal behaviour detected'
    }


