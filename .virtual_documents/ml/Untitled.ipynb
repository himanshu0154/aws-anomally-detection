import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


df = pd.read_csv("../data/weather_data.csv")


df.head()


df[(df['T2M'] == -999)].shape


df[(df['RH2M'] == -999)].shape


df[(df['PS'] == -999)].shape


df[(df['T2M'] == -999) |
   (df['RH2M'] == -999) |
   (df['PS'] == -999)].shape


df[(df['T2M'] == -999) & 
   (df['RH2M'] == -999) & 
   (df['PS'] == -999)].shape


df[['T2M', 'RH2M', 'PS']] = df[['T2M', 'RH2M', 'PS']].replace(-999, np.nan)


df.isnull().sum()


df.dropna(subset=['T2M', 'RH2M', 'PS'], inplace=True)


df.shape


df['datetime'] = pd.to_datetime(
    df[['YEAR', 'MO', 'DY', 'HR']]
    .rename(columns={
        'YEAR': 'year',
        'MO': 'month',
        'DY': 'day',
        'HR': 'hour'
    })
)


df.head()


df.info()


df[['YEAR', 'MO', 'DY', 'HR', 'datetime']]


df.drop(columns=['YEAR', 'MO', 'DY', 'HR'], inplace=True)


df.head()


df.to_csv("../data/weather_cleaned.csv", index=False)



